<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/fondo_tarjeta"
    android:orientation="vertical" android:padding="18dp">
    <TextView android:id="@+id/nombre" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="19sp"
        android:textStyle="bold" android:textColor="@color/garage_green" />
    <TextView android:id="@+id/detalle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textSize="14sp" android:textColor="@color/garage_muted" />
</LinearLayout>
